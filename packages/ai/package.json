{
	"name": "@enterprise-agent/ai",
	"version": "0.1.0",
	"description": "LiteLLM client runtime for Enterprise Agent",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": ["./dist/compat.js"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/openai-completions": {
			"types": "./dist/api/openai-completions.d.ts",
			"import": "./dist/api/openai-completions.js"
		},
		"./api/google-generative-ai": {
			"types": "./dist/api/google-generative-ai.d.ts",
			"import": "./dist/api/google-generative-ai.js"
		},
		"./api/openai-responses": {
			"types": "./dist/api/openai-responses.d.ts",
			"import": "./dist/api/openai-responses.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "node ../../node_modules/vitest/dist/cli.js --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"openai": "6.26.0",
		"partial-json": "0.1.7",
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"llm",
		"litellm",
		"openai-compatible",
		"api"
	],
	"author": "Enterprise Engineering",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"vitest": "4.1.9"
	}
}
