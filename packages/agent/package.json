{
	"name": "@enterprise-agent/agent-core",
	"version": "0.1.0",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "node ../../node_modules/vitest/dist/cli.js --run",
		"test:harness": "node ../../node_modules/vitest/dist/cli.js --run --config vitest.harness.config.ts",
		"coverage:harness": "node ../../node_modules/vitest/dist/cli.js --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@enterprise-agent/ai": "0.1.0",
		"ignore": "7.0.5",
		"typebox": "1.1.38",
		"yaml": "2.9.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Enterprise Engineering",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@vitest/coverage-v8": "4.1.9",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
