{
	"name": "@enterprise-agent/orchestrator",
	"version": "0.1.0",
	"description": "Experimental orchestrator package for Enterprise Agent",
	"type": "module",
	"bin": {
		"orchestrator": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "node node_modules/vitest/dist/cli.js --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"enterprise-agent",
		"orchestrator"
	],
	"author": "Enterprise Engineering",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@enterprise-agent/coding-agent": "0.1.0"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
